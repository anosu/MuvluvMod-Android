<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(ModRepositoryRoot)shared/ModEngineering/build/Android.props" />
    <PropertyGroup>
        <AssemblyName>MuvluvMod</AssemblyName>
        <Product>MuvluvMod</Product>
        <Version>1.2.1</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>MuvluvMod</RootNamespace>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <Reference
            Include="Assembly-CSharp"
            HintPath="$(GameInteropReferenceDirectory)/Assembly-CSharp.dll"
            Private="false"
        />
        <Reference
            Include="Il2CppApi"
            HintPath="$(GameInteropReferenceDirectory)/Il2CppApi.dll"
            Private="false"
        />
        <Reference
            Include="Il2CppBattle"
            HintPath="$(GameInteropReferenceDirectory)/Il2CppBattle.dll"
            Private="false"
        />
        <Reference
            Include="Il2CppExternals"
            HintPath="$(GameInteropReferenceDirectory)/Il2CppExternals.dll"
            Private="false"
        />
        <Reference
            Include="Il2CppGameUi"
            HintPath="$(GameInteropReferenceDirectory)/Il2CppGameUi.dll"
            Private="false"
        />
        <Reference
            Include="Il2Cppmscorlib"
            HintPath="$(GameInteropReferenceDirectory)/Il2Cppmscorlib.dll"
            Private="false"
        />
        <Reference
            Include="Il2CppUniTask"
            HintPath="$(GameInteropReferenceDirectory)/Il2CppUniTask.dll"
            Private="false"
        />
        <Reference
            Include="Il2CppUiComponentSystem"
            HintPath="$(GameInteropReferenceDirectory)/Il2CppUiComponentSystem.dll"
            Private="false"
        />
        <Reference
            Include="Il2CppVisualEffects"
            HintPath="$(GameInteropReferenceDirectory)/Il2CppVisualEffects.dll"
            Private="false"
        />
        <Reference
            Include="Unity.RenderPipelines.Universal.Runtime"
            HintPath="$(GameInteropReferenceDirectory)/Unity.RenderPipelines.Universal.Runtime.dll"
            Private="false"
        />
        <Reference
            Include="Unity.TextMeshPro"
            HintPath="$(GameInteropReferenceDirectory)/Unity.TextMeshPro.dll"
            Private="false"
        />
        <Reference
            Include="UnityEngine.AssetBundleModule"
            HintPath="$(GameInteropReferenceDirectory)/UnityEngine.AssetBundleModule.dll"
            Private="false"
        />
        <Reference
            Include="UnityEngine.CoreModule"
            HintPath="$(GameInteropReferenceDirectory)/UnityEngine.CoreModule.dll"
            Private="false"
        />
        <Reference
            Include="UnityEngine.IMGUIModule"
            HintPath="$(GameInteropReferenceDirectory)/UnityEngine.IMGUIModule.dll"
            Private="false"
        />
        <Reference
            Include="UnityEngine.TextRenderingModule"
            HintPath="$(GameInteropReferenceDirectory)/UnityEngine.TextRenderingModule.dll"
            Private="false"
        />
        <Reference
            Include="UnityEngine.UI"
            HintPath="$(GameInteropReferenceDirectory)/UnityEngine.UI.dll"
            Private="false"
        />
    </ItemGroup>
    <Import Project="$(ModRepositoryRoot)shared/ModEngineering/build/SharedDependencies.props" />
    <Target Name="CollectExtraPackageFiles" BeforeTargets="GetModPackageFiles">
        <ItemGroup>
            <ModPackageFile
                Include="$(ModRepositoryRoot)dependencies/font/sarasagothicsc-bold"
                Destination="UserData/MuvluvMod/sarasagothicsc-bold"
            />
        </ItemGroup>
    </Target>
</Project>
